# Copy to `.env` and fill in. `.env` is gitignored.

# --- Cloud LLM (at least one required unless using --local-only) ---

# Active defaults (configs/router.yaml):
#   cloud_frontier → zai / glm-5-turbo (supervisor)
#   vision         → zai_vision / glm-5v-turbo (GLM-5V)
ZAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Voice STT + TTS (config.yaml voice.stt / voice.tts → groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback / alternate providers (optional)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx
KILO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
KIE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Alias for Gemini:
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: require Bearer token on sidecar POST /run, /stop, /stt, /tts
# AETHER_SIDECAR_TOKEN=your-local-secret
# AETHER_SIDECAR_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Optional: HMAC key for audit log (32+ bytes; see docs/SECURITY_AUDIT.md)
# AETHER_AUDIT_KEY=your-audit-hmac-secret
