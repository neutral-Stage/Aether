{
  "name": "press_key",
  "description": "Press a key with optional modifiers, e.g. key='return', or key='c' modifiers=['cmd'].",
  "input_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string"
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "key"
    ]
  },
  "permission": "input",
  "impact": "reversible"
}
