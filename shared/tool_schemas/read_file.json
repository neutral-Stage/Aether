{
  "name": "read_file",
  "description": "Read a text file (size-capped; use offset to page through big files).",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "max_bytes": {
        "type": "integer"
      }
    },
    "required": [
      "path"
    ]
  },
  "permission": "files",
  "impact": "read"
}
