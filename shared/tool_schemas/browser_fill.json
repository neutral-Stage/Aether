{
  "name": "browser_fill",
  "description": "Fill a form field in the browser (optional tab_id).",
  "input_schema": {
    "type": "object",
    "properties": {
      "selector": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "tab_id": {
        "type": "integer"
      }
    },
    "required": [
      "selector",
      "text"
    ]
  },
  "permission": "network",
  "impact": "reversible"
}
